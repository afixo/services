# Copy to .env (gitignored). `make dev` exports these per service.
# Ports: gateway 8080 (console) / 8081 (machine); auth 50051; identity 50052;
# policy 50053; disclosure 50054; audit 50055.

RUST_LOG=info,sqlx=warn

# --- infra (docker compose up -d) ---
AUTH_DATABASE_URL=postgres://afixo:afixo@localhost:5432/afixo_auth
IDENTITY_DATABASE_URL=postgres://afixo:afixo@localhost:5432/afixo_identity
POLICY_DATABASE_URL=postgres://afixo:afixo@localhost:5432/afixo_policy
AUDIT_DATABASE_URL=postgres://afixo:afixo@localhost:5432/afixo_audit

# --- service discovery (local ports) ---
AUTH_URL=http://localhost:50051
IDENTITY_URL=http://localhost:50052
POLICY_URL=http://localhost:50053
DISCLOSURE_URL=http://localhost:50054
AUDIT_URL=http://localhost:50055

# --- gateway ---
CONSOLE_ADDR=0.0.0.0:8080
MACHINE_ADDR=0.0.0.0:8081
CORS_ALLOWED_ORIGINS=http://localhost:4321

# --- auth: GitHub OAuth app (callback goes through the web Worker) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4321/api/v1/auth/github/callback
